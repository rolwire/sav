{
  "name": "ark-covenant-cinematic",
  "version": "1.0.0",
  "description": "Ark of the Covenant — 20-scene cinematic Remotion sequence",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render ArkCovenant out/ark-covenant.mp4",
    "render": "npx remotion render ArkCovenant out/ark-covenant.mp4",
    "still": "npx remotion still ArkCovenant --frame=0 out/still.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  }
}
