{
  "name": "ark-covenant-cinematic",
  "version": "1.0.0",
  "description": "Ark of the Covenant — 20-scene cinematic Remotion sequence",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render ArkCovenant out/ark-covenant.mp4",
    "render": "npx remotion render ArkCovenant out/ark-covenant.mp4",
    "still": "npx remotion still ArkCovenant --frame=0 out/still.png",
    "reel": "tsx pipeline/run.ts",
    "reel:demo": "tsx pipeline/demo.ts",
    "reel:render": "npx remotion render MapReel out/mapreel.mp4",
    "reel:render:wide": "npx remotion render MapReelWide out/mapreel-wide.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/install-whisper-cpp": "^4.0.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "flag-icons": "^7.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
