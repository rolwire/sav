{
  "manifest_version": 3,
  "name": "YouTube Channel Exporter",
  "version": "1.0.0",
  "description": "Collect every video from a YouTube channel, sort by highest views, copy titles, grab thumbnails, and export to Excel (.xlsx) or CSV.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Channel Exporter"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
